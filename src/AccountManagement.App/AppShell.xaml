<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AccountManagement.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AccountManagement.App.Views"
    Shell.FlyoutBehavior="Flyout"
    FlyoutWidth="280"
    BackgroundColor="#08294D"
    FlyoutBackgroundColor="#08294D"
    Title="Rupali Account Management System">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,24,20,16" BackgroundColor="#08294D" Spacing="10">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border Stroke="#3D73B0" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="2" HeightRequest="56" WidthRequest="56" BackgroundColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="rupali_logo.png" Aspect="AspectFit" HeightRequest="52" WidthRequest="52" />
                </Border>
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="রূপালী একাউন্টস" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" />
                    <Label Text="RUPALI ACCOUNT" FontSize="11" FontAttributes="Bold" TextColor="#34D399" CharacterSpacing="0.8" />
                    <Label Text="Press &amp; Packaging ERP" FontSize="10" TextColor="#DCE3EF" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <BoxView HeightRequest="1" BackgroundColor="#1E3A8A" Margin="0,6,0,0" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Dashboard | ড্যাশবোর্ড" Route="DashboardPage">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Daily Ledger | জাবেদা ও খতিয়ান" Route="LedgerPage">
        <ShellContent ContentTemplate="{DataTemplate views:LedgerPage}" />
    </FlyoutItem>

    <FlyoutItem Title="+ New Job | নতুন এন্ট্রি" Route="NewTransactionPage">
        <ShellContent ContentTemplate="{DataTemplate views:NewTransactionPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Material Rates | রেট শিট" Route="RateManagerPage">
        <ShellContent ContentTemplate="{DataTemplate views:RateManagerPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Customers | গ্রাহকদের হিসাব" Route="CustomerManagerPage">
        <ShellContent ContentTemplate="{DataTemplate views:CustomerManagerPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Payments &amp; Expenses | জমা ও খরচ" Route="PaymentExpensePage">
        <ShellContent ContentTemplate="{DataTemplate views:PaymentExpensePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Backup &amp; Security | ব্যাকআপ" Route="BackupRestorePage">
        <ShellContent ContentTemplate="{DataTemplate views:BackupRestorePage}" />
    </FlyoutItem>

</Shell>
