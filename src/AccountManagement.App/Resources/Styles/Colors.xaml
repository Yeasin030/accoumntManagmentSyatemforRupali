<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary Brand Identity -->
    <Color x:Key="Primary">#3D73B0</Color>
    <Color x:Key="PrimaryDark">#08294D</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#DCE3EF</Color>
    <Color x:Key="SecondaryDarkText">#08294D</Color>
    <Color x:Key="Tertiary">#08294D</Color>

    <!-- Executive Enterprise Palette -->
    <Color x:Key="BrandCanvas">#F8FAFC</Color>
    <Color x:Key="BrandSurface">#DCE3EF</Color>
    <Color x:Key="BrandPrimary">#3D73B0</Color>
    <Color x:Key="BrandNavy">#08294D</Color>
    <Color x:Key="BrandNavyDark">#051B33</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBorder">#E2E8F0</Color>
    <Color x:Key="CardBorderHover">#CBD5E1</Color>

    <!-- Semantic Financial Status Tokens -->
    <Color x:Key="SuccessGreen">#059669</Color>
    <Color x:Key="SuccessGreenBg">#ECFDF5</Color>
    <Color x:Key="SuccessGreenBorder">#A7F3D0</Color>
    <Color x:Key="WarningAmber">#D97706</Color>
    <Color x:Key="WarningAmberBg">#FFFBEB</Color>
    <Color x:Key="WarningAmberBorder">#FDE68A</Color>
    <Color x:Key="DangerRose">#E11D48</Color>
    <Color x:Key="DangerRoseBg">#FFF1F2</Color>
    <Color x:Key="DangerRoseBorder">#FECDD3</Color>

    <!-- Slate Typography Scale -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="TextLight">#FFFFFF</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#08294D</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavy}"/>
    <SolidColorBrush x:Key="BrandCanvasBrush" Color="{StaticResource BrandCanvas}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>